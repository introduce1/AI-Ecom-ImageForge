# Gemini 3 Pro API Key (图像编辑专用)
GEMINI3_PRO_API_KEY=your_gemini3_pro_api_key_here

# Jiekou.ai API Key (统一平台，用于 FLUX/GPT/Qwen/SD/Recraft 等模型)
JIEKOU_API_KEY=your_jiekou_api_key_here

# ImgBB 图床 API Key (可选，注册: https://api.imgbb.com/)
IMGBB_API_KEY=your_imgbb_api_key_here

# Imgur Client ID (可选，注册: https://api.imgur.com/oauth2/addclient)
IMGUR_CLIENT_ID=your_imgur_client_id_here
